# Carivyo works without an environment file. These values document safe local defaults.
CARIVYO_DATA_DIR=.carivyo
CARIVYO_HOST=127.0.0.1
CARIVYO_PORT=8420
# `scripts/dev.sh` creates this automatically. Set a private value only when
# starting backend and frontend separately, then open `/#bootstrap=<value>`.
# CARIVYO_BOOTSTRAP_TOKEN=replace-with-a-random-private-value
CARIVYO_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Runtime and request budgets
CARIVYO_RUNTIME_TIMEOUT_SECONDS=120
CARIVYO_MAX_CHAT_INPUT_TOKENS=6000
CARIVYO_MAX_CHAT_OUTPUT_TOKENS=900
# `./run-demo.sh` uses this model through an authenticated Codex CLI and makes
# it the selected runtime. Ollama remains available as the local alternative.
CARIVYO_CODEX_MODEL=gpt-5.6-terra
# Optional preferred on-device model. If unset, Carivyo uses the first installed
# non-cloud Ollama model. Ollama entries with remote_host/remote_model are never
# reported as local.
# CARIVYO_OLLAMA_MODEL=llama3.1:latest
# Reject provider-backed calls instead of falling back when Ollama is unavailable.
# CARIVYO_FULLY_LOCAL_MODE=true
CARIVYO_LOCAL_HIRING_AGENT_ENABLED=true

# Optional authorized Enhancv ATS report. Keep real values only in the ignored
# `.env`; Carivyo never returns the password through an API or writes it to a run.
# CARIVYO_ENHANCV_EMAIL=you@example.com
# CARIVYO_ENHANCV_PASSWORD=replace-locally
# On macOS, set this instead to use the `enhancv.com` Keychain item.
CARIVYO_ENHANCV_USE_KEYCHAIN=false
# CARIVYO_ENHANCV_SCRIPT_PATH=/absolute/path/to/enhancv_resume_checker.py
CARIVYO_ENHANCV_PLAYWRIGHT_REPO=frontend
CARIVYO_ENHANCV_HEADLESS=false
CARIVYO_ENHANCV_TIMEOUT_SECONDS=540

# Connector controls
CARIVYO_REQUEST_TIMEOUT_SECONDS=15
CARIVYO_MAX_JOBS_PER_SOURCE=80
CARIVYO_CONNECTOR_CONCURRENCY=6
CARIVYO_CONNECTOR_MIN_INTERVAL_SECONDS=0.15
CARIVYO_CONNECTOR_DEADLINE_SECONDS=60

# Testing only: point at backend/tests/fixtures/jobs.json for deterministic jobs.
# CARIVYO_FIXTURE_JOBS_PATH=/absolute/path/to/backend/tests/fixtures/jobs.json

CARIVYO_LOG_LEVEL=INFO
